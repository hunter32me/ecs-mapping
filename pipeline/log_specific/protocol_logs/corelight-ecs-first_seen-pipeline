   {
  "description": "Corelight ECS ingest pipeline for first_seen logs. Runs after corelight-ecs-common-main-pipeline and matches the first_seen Logstash filter.",
  "version": 2026102701,
  "processors": [
    { 
      "set": { 
      "field": "event.kind",
       "value": "event" 
       } 
      },
    { 
      "set": { 
        "field": "event.category", 
        "value": "network" 
        } 
      },
    { 
      "set": { 
        "field": "event.type", 
        "value": "info" 
        } 
      },
    { 
      "set": { 
        "field": "labels.corelight.event_category", 
        "value": "network_observations" 
        } 
      },
    { 
      "set": {
         "field": "temporary_metadata_index_name_type", 
         "value": "logs" 
         } 
        },
    {
      "set": {
        "field": "temporary_metadata_index_name_dataset_prefix",
        "value": "corelight"
      }
    },
    {
      "set": {
        "field": "temporary_metadata_index_name_dataset_suffix",
        "value": "various"
      }
    },
    {
      "set": {
        "field": "temporary_metadata_index_name_namespace",
        "value": "default"
      }
    },
    {
      "rename": {
        "field": "entity",
        "target_field": "first_seen.entity",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "original_entity",
        "target_field": "first_seen.original_entity",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "first_seen_type",
        "target_field": "first_seen.type",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "history",
        "target_field": "first_seen.history_seconds",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "history_days",
        "target_field": "first_seen.history_days",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "item",
        "target_field": "first_seen.item",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "use_case",
        "target_field": "first_seen.use_case",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "use_case_description",
        "target_field": "first_seen.use_case_description",
        "ignore_missing": true
      }
    }
  ]
}